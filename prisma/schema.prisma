generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String?
  role           Role           @default(STUDENT)
  createdAt      DateTime       @default(now())
  isApproved     Boolean        @default(false)
  emailVerified  DateTime?
  accounts       Account[]
  announcements  Announcement[]
  doubtsAsked    Doubt[]        @relation("StudentDoubts")
  doubtsAnswered Doubt[]        @relation("TeacherAnswers")
  liveClasses    LiveClass[]
  quizzes        Quiz[]         @relation("TeacherQuizzes")
  quizAttempts   QuizAttempt[]
  sessions       Session[]
}

model Quiz {
  id          String        @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime      @default(now())
  teacherId   String
  duration    Int           @default(30)
  isActive    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  questions   Question[]
  teacher     User          @relation("TeacherQuizzes", fields: [teacherId], references: [id])
  attempts    QuizAttempt[]
}

model Question {
  id       String @id @default(uuid())
  question String
  optionA  String
  optionB  String
  optionC  String
  optionD  String
  answer   String
  quizId   String
  quiz     Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  score       Int
  quizId      String
  studentId   String
  answers     Json?
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model LiveClass {
  id          String   @id @default(uuid())
  topic       String
  description String?
  scheduledAt DateTime
  meetingLink String
  createdAt   DateTime @default(now())
  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
}

model Doubt {
  id         String    @id @default(uuid())
  question   String
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  studentId  String
  teacherId  String?
  student    User      @relation("StudentDoubts", fields: [studentId], references: [id])
  teacher    User?     @relation("TeacherAnswers", fields: [teacherId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  token      String   @unique
  expires    DateTime
  identifier String

  @@unique([identifier, token])
}

model Announcement {
  id        String   @id @default("GLOBAL")
  title     String
  content   String
  createdAt DateTime @default(now())
  teacherId String
  updatedAt DateTime @updatedAt
  teacher   User     @relation(fields: [teacherId], references: [id])
}

model PasswordResetToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  TEACHER
  STUDENT
}
